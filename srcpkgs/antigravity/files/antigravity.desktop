[Desktop Entry]
Name=Antigravity
Comment=Google's fork of VS Code for Gemini agentic coding
Exec=antigravity %F
Icon=antigravity
Type=Application
StartupNotify=true
Categories=Development;IDE;
MimeType=text/plain;inode/directory;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=antigravity --new-window
Icon=antigravity
